# ==============================================================================
# Learn With Avee — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in backend/ or root and fill in the values.
# NEVER commit real credentials or secrets to version control.

# Node Environment
NODE_ENV=development
PORT=5000

# MongoDB Database (Atlas or local replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/learn_with_avee?retryWrites=true&w=majority

# Security & Authentication
# JWT Secret: Strong random string (min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# AES-256-GCM Encryption Key (Must be 32 bytes hex or 32 characters)
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Service URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# AI Provider API Keys (Can also be configured dynamically in Dashboard Settings)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Default AI Settings
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.5-flash

# Meta / Instagram Graph API Configuration
INSTAGRAM_APP_ID=
INSTAGRAM_CONFIG_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/instagram/callback

# n8n Automation Engine Integration
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=your_secure_n8n_webhook_secret_key_here

# Media Storage Provider (options: local, cloudinary, supabase)
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=instagram-assets

# PostgreSQL Database URL (Used by persistent n8n community instance)
POSTGRES_DATABASE_URL=postgres://n8n:n8n_password@postgres:5432/n8n

