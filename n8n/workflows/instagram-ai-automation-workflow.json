    {
      "parameters": {
        "jsCode": "// Filter and route rows based on pipeline state\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const topic = (row.Topic || row.topic || '').trim();\n  const approvalStatus = (row.Approval_Status || row.approval_status || 'Draft').trim();\n  const publishingStatus = (row.Publishing_Status || row.publishing_status || 'Not_Started').trim();\n  const caption = (row.Generated_Caption || row.generated_caption || '').trim();\n  const mediaUrl = (row.Media_URL || row.media_url || '').trim();\n\n  // Skip completely empty rows\n  if (!topic && !mediaUrl) continue;\n\n  let action = 'SKIP';\n  \n  // Phase 1: Topic present, but caption not yet generated -> Needs AI Generation\n  if (topic && !caption && publishingStatus !== 'Published') {\n    action = 'GENERATE_AI_CONTENT';\n  }\n  // Phase 2: User explicitly marked row as Approved and not yet published -> Ready to Publish\n  else if (approvalStatus.toLowerCase() === 'approved' && publishingStatus.toLowerCase() !== 'published' && mediaUrl) {\n    action = 'PUBLISH_TO_INSTAGRAM';\n  }\n  // Phase 3: Pending review or draft -> Waiting for human approval\n  else if (approvalStatus.toLowerCase() === 'pending_review') {\n    action = 'AWAITING_APPROVAL';\n  }\n\n  results.push({\n    json: {\n      ...row,\n      action,\n      row_number: row.row_number || item.pairedItem?.item || 0\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "evaluate-row-state",
      "name": "Evaluate Row State & Routing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [820, 400]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "GENERATE_AI_CONTENT",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Generate AI Content"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
