    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "HTTP-Referer",
              "value": "https://instagram-automation-lwav.app.n8n.cloud"
            },
            {
              "name": "X-Title",
              "value": "Learn With Avee Instagram Automation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $('Workflow Configuration').item.json.openrouter_model }}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a viral Instagram content strategist and copywriter for the Instagram account @lw_avee (focus: AI, Tech, Automation, No-Code, Future Tools in conversational Hindi/Hinglish and English).\\n\\nYour job is to generate:\\n1. An ultra-engaging, high-retention Instagram caption for a Reel/Post on the given topic.\\n2. Strong 2-second visual hook at the start.\\n3. Concise, punchy bullet points highlighting core insights or tools.\\n4. High-converting Call to Action (e.g., 'Comment AI and I will DM you the direct link! Follow @lw_avee for daily AI updates').\\n5. 15-20 highly relevant, trending hashtags categorized into niche (#LearnWithAvee #AITools), category (#ArtificialIntelligence #Automation), and viral hashtags.\\n\\nOutput format MUST be strict JSON:\\n{\\n  \\\"caption\\\": \\\"Full caption text with emojis and formatting\\\",\\n  \\\"hashtags\\\": \\\"#hashtag1 #hashtag2 ...\\\"\\n}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Create an Instagram caption and hashtags for the following topic:\\nTopic: {{ $json.Topic || $json.topic }}\\nFormat: {{ $json.Content_Type || 'REEL' }}\\nTarget Audience: Tech enthusiasts, creators, students, and entrepreneurs.\"\n    }\n  ],\n  \"temperature\": 0.7,\n  \"response_format\": { \"type\": \"json_object\" }\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "openrouter-ai-generation",
      "name": "Generate Caption & Hashtags via OpenRouter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 240],
      "credentials": {
        "httpHeaderAuth": {
          "id": "openrouter-api-key",
          "name": "OpenRouter API Key Header"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse OpenRouter response and format for Google Sheets update\nconst item = $input.item.json;\nconst prevRow = $('Evaluate Row State & Routing').item.json;\n\nlet parsedAi;\ntry {\n  const contentRaw = item.choices[0].message.content;\n  parsedAi = JSON.parse(contentRaw);\n} catch (e) {\n  parsedAi = {\n    caption: item.choices?.[0]?.message?.content || 'Failed to parse caption',\n    hashtags: '#AI #Tech #Automation #LearnWithAvee'\n  };\n}\n\nreturn {\n  json: {\n    ...prevRow,\n    Generated_Caption: parsedAi.caption || '',\n    Generated_Hashtags: parsedAi.hashtags || '',\n    Approval_Status: 'Pending_Review', // STRICT MANUAL APPROVAL: Stage for human approval\n    Publishing_Status: 'Ready for Approval',\n    Error_Message: '',\n    Updated_At: new Date().toISOString()\n  }\n};"
      },
      "id": "format-ai-output",
      "name": "Format AI Output & Stage for Approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 240]
