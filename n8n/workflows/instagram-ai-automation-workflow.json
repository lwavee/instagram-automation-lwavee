      "id": "read-google-sheet",
      "name": "Read Topics from Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [600, 400],
      "credentials": {
        "googleSheetsOAuth2": {
