    {
      "parameters": {
        "jsCode": "// Prepare parameters according to Meta Graph API Container Workflow\nconst item = $input.item.json;\nconst contentType = (item.Content_Type || item.content_type || 'REEL').toUpperCase();\nconst mediaUrl = item.Media_URL || item.media_url;\nconst coverUrl = item.Cover_URL || item.cover_url || '';\nconst caption = item.Generated_Caption || item.generated_caption || '';\nconst hashtags = item.Generated_Hashtags || item.generated_hashtags || '';\n\nconst fullCaption = `${caption}\\n\\n.\\n.\\n${hashtags}`.trim();\n\nconst payload = {\n  caption: fullCaption,\n  contentType\n};\n\nif (contentType === 'REEL' || contentType === 'REELS' || contentType === 'VIDEO') {\n  payload.media_type = 'REELS';\n  payload.video_url = mediaUrl;\n  payload.share_to_feed = 'true';\n  if (coverUrl && coverUrl.startsWith('http')) {\n    payload.cover_url = coverUrl;\n  }\n} else {\n  payload.image_url = mediaUrl;\n}\n\nreturn {\n  json: {\n    ...item,\n    metaPayload: payload\n  }\n};"
      },
