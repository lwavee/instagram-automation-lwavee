{
  "name": "Workflow B — AI Script Generation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-scripts",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "generate-scripts-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_API_URL || 'http://localhost:5000' }}/api/scripts/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET || 'your_secure_n8n_webhook_secret_key_here' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"topic\": \"{{ $json.body.topic || 'Artificial Intelligence' }}\",\n  \"format\": \"REEL\",\n  \"language\": \"Hinglish\",\n  \"targetDurationSeconds\": 45\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "generate-script-call",
      "name": "Generate Hindi/Hinglish Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_API_URL || 'http://localhost:5000' }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET || 'your_secure_n8n_webhook_secret_key_here' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"action\": \"script_ready\",\n  \"workflowName\": \"Workflow B — AI Script Generation\",\n  \"executionId\": \"{{ $execution.id }}\",\n  \"payload\": {\n    \"scriptId\": \"{{ $json.data.script._id }}\",\n    \"reelTitle\": \"{{ $json.data.script.reelTitle }}\"\n  }\n}",
        "options": {}
      },
      "id": "notify-dashboard",
      "name": "Send Ready Notification to Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Generate Hindi/Hinglish Script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Hindi/Hinglish Script": {
      "main": [
        [
          {
            "node": "Send Ready Notification to Dashboard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  }
}
